function writeConf(c) { const tmp = CONF + ".part"; fs.writeFileSync(tmp, JSON.stringify(c, null, 1) + "\n", { mode: 0o600 }); fs.renameSync(tmp, CONF); lockDown(CONF); }
function readHookFile(f) { // JSON {url, headers} or setup's format: the webhook URL line, then 'Name: value' header lines
